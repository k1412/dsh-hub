# From the repository root: cp deploy/gateway/.env.example deploy/gateway/.env
# Then: chmod 600 deploy/gateway/.env; edit it and choose ONE authentication mode.
# Pass --env-file deploy/gateway/.env to the source-build Compose command.
# The proxy must serve this origin and *.<this hostname> over HTTPS.
DSH_GATEWAY_PUBLIC_URL=https://hub.example.com
DSH_GATEWAY_PORT=8080
# Optional separate origin for installation resources (required when Access
# protects the management origin and command-line installers cannot log in).
DSH_GATEWAY_DOWNLOAD_URL=

# Standalone mode: set a unique password with at least 16 characters.
DSH_GATEWAY_OWNER_PASSWORD=

# Cloudflare Access mode: leave OWNER_PASSWORD empty and set ALL values below.
DSH_GATEWAY_CF_TEAM_DOMAIN=
DSH_GATEWAY_CF_AUDIENCE=
DSH_GATEWAY_OPERATOR_EMAILS=
# The trusted reverse proxy must overwrite X-DSH-Origin-Secret with this value.
DSH_GATEWAY_ORIGIN_SECRET=
