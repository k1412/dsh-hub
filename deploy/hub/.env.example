# HTTPS origin protected by a Cloudflare Access self-hosted application.
DSH_HUB_PUBLIC_ORIGIN=https://hub.example.com
DSH_HUB_CF_TEAM_DOMAIN=team.cloudflareaccess.com
DSH_HUB_CF_AUDIENCE=replace-with-access-application-audience
DSH_HUB_OPERATOR_EMAILS=operator@example.com

# Generate independently with a cryptographically secure random source.
# The reverse proxy adds this value to every origin request and removes any
# client-supplied header with the same name.
DSH_HUB_ORIGIN_SECRET=replace-with-at-least-32-random-characters

# Optional immutable image reference and loopback host port.
DSH_HUB_IMAGE=ghcr.io/k1412/dsh-hub:latest
DSH_HUB_BIND_PORT=8080
