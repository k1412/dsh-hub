{
  "name": "@k1412/dsh-gateway-node",
  "version": "2.0.0-alpha.1",
  "description": "Native DSH surface over an outbound paired Hub tunnel",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-gateway-node": "lib/cli.js"
  },
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./surface": {
      "types": "./lib/types/surface.d.ts",
      "default": "./lib/surface.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@k1412/dsh-gateway-network": "workspace:*",
    "@k1412/dsh-gateway-transport": "workspace:*",
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-client-modules": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-web-frontend": "0.1.7-rc.2"
  }
}
